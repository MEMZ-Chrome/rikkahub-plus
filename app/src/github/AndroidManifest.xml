<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- 工作区挂载共享存储目录需要「所有文件访问权限」；Play 对这个权限审核很严，只在 github 渠道声明 -->
  <uses-permission
    android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
    tools:ignore="ScopedStorage" />

  <!-- Android 11 以下 Phone Use 用录屏取帧代替无障碍截图 -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

  <!-- Phone Use 的 Shizuku 执行方式：由 Shizuku 授予 adb 级 shell 权限 -->
  <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

  <!-- 通知设置里直接弹出「忽略电池优化」的系统对话框；Play 只允许特定类型的应用申请，Play 版改为打开系统的电池优化列表 -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

  <application>
    <!-- Shizuku 通过这个 provider 把 binder 交给本应用，包名后缀由 Shizuku 约定；
         INTERACT_ACROSS_USERS_FULL 是官方推荐，防止普通应用访问这个 provider -->
    <provider
      android:name="rikka.shizuku.ShizukuProvider"
      android:authorities="${applicationId}.shizuku"
      android:enabled="true"
      android:exported="true"
      android:multiprocess="false"
      android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    <!-- Phone Use：只在 github 渠道声明，Play 不允许用无障碍服务做自动化 -->
    <service
      android:name=".phoneuse.PhoneUseAccessibilityService"
      android:exported="true"
      android:label="@string/phone_use_accessibility_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/phone_use_accessibility" />
    </service>

    <!-- 录屏取帧：只在用户手动开启时运行，系统会在状态栏显示录屏提示 -->
    <service
      android:name=".phoneuse.PhoneScreenCaptureService"
      android:exported="false"
      android:foregroundServiceType="mediaProjection" />
  </application>

</manifest>
